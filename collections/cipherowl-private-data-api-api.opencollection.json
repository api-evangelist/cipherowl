            "url": "https://svc.cipherowl.ai/api/private-data/v1/overrides/chains/:chain/addresses/:address",
            "params": [
              {
                "name": "chain",
                "value": "",
                "type": "path"
              },
              {
                "name": "address",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete override"
        },
        {
          "info": {
            "name": "List overrides",
            "type": "http"
          },
          "http": {
