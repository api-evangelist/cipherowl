              },
              {
                "name": "sinceTimestamp",
                "value": "",
                "type": "query",
                "description": "Optional: if provided, only return entries modified since this timestamp"
              }
            ]
          },
          "docs": "List overrides"
        },
        {
          "info": {
            "name": "Upsert override",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://svc.cipherowl.ai/api/private-data/v1/overrides/chains/:chain/addresses",
