          "name": "Batch get balances",
          "request": {
            "name": "Batch get balances",
            "description": {
              "content": "Retrieves balance information for up to 100 addresses on the same blockchain in a single efficient request. Partial failures are supported - if some addresses fail, successful results are still returned with error details for failed addresses.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "onchain",
                "v1",
                "chains",
                ":chain",
                "balances:batchget"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chain",
                  "description": "(Required) Network identifier - all addresses must be on this chain"
                }
              ]
            },
